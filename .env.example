# Model server + AI model — any server speaking the OpenAI-compatible protocol.
# Default is Ollama (runs on macOS, Linux and Windows). Copy to .env to override.
# .env is gitignored; never commit real keys.
MODEL_SERVER_URL=http://localhost:11434/v1
AI_MODEL=qwen3.5:4b
MODEL_SERVER_API_KEY=ollama

# How this model server switches the AI model's thinking off (Ollama's spelling).
# Another model server needs its own spelling here; the startup self-test tells you if it's wrong.
MODEL_SERVER_EXTRA_BODY={"reasoning_effort": "none"}

# Where the audit records are stored (SQLite file by default; PostgreSQL in the Docker setup).
DATABASE_URL=sqlite:///audit.db

# How long to wait for the AI model before the claim goes to a person instead.
MODEL_SERVER_TIMEOUT_SECONDS=60
