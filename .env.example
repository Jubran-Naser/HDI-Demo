# Local model engine — any OpenAI-compatible endpoint.
# Default is Ollama (runs on macOS, Linux and Windows). Copy to .env to override.
# .env is gitignored; never commit real keys.
ENGINE_BASE_URL=http://localhost:11434/v1
ENGINE_MODEL=qwen3.5:4b
ENGINE_API_KEY=ollama

# Alternative on Apple Silicon: OMLX (MLX-optimised), e.g.
# ENGINE_BASE_URL=http://localhost:8002/v1
# ENGINE_MODEL=Qwen3.5-4B-MLX-4bit
# ENGINE_API_KEY=<your OMLX key>
